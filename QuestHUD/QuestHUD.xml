<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

	<Script file="QuestHUD.lua"/>
	<Script file="modules/CardinalPoints.lua"/>


	<FontString name="QuestHUDFont" inherits="SystemFont_Small2" outline="THICK" hidden="true" virtual="true">
		<Shadow>
			<Offset x=".2" y="-.2"/>
			<Color r="0" g="0" b="0"/>
		</Shadow>
	</FontString>

	<Button name="QuestHUDOnScreenButtonTemplate" virtual="true">
		<Size x="20" y="20"/>
		<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
		<Scripts>
			<OnClick>
				local id = self:GetID();
				if id==1 then
					QuestHUD:ToggleMouse();
				elseif id==2 then
					QuestHUD:ToggleBackground();
				elseif id==3 then
					QuestHUD:ToggleOptions();
				elseif id==4 then
					QuestHUD:Toggle(false)
				end
			</OnClick>
		</Scripts>
	</Button>

	<Button name="QuestHUDMinimapDummy" mixin="QuestHUDMinimapDummyMixin" hidden="true" enableMouse="false">
		<Layers>
			<Layer level="BACKGROUND" textureSubLevel="-2">
				<Texture file="interface/GLUES/CREDITS/Pandaria/Sha_SizeProgression_011" setallpoints="true" hidden="true" parentKey="bg" mask="interface/CHARACTERFRAME/TempPortraitAlphaMask" alpha="0.6">
					<Color r="0" g="0" b="0" a="1" />
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnMouseUp method="OnMouseUp"/>
			<OnMouseDown method="OnMouseDown"/>
		</Scripts>
	</Button>


	<Frame name="QuestHUD" parent="UIParent" mixin="QuestHUDMixin" frameStrata="BACKGROUND" alpha="1" hidden="true">
		<Size x="140" y="140"/>
		<Anchors>
			<!-- Anchored to WorldFrame for view port changed by users -->
			<Anchor point="CENTER" relativeTo="WorldFrame" relativePoint="CENTER" />
		</Anchors>
		<Frames>
			<Frame parentKey="cluster">
				<Anchors>
					<Anchor point="CENTER" relativePoint="CENTER" />
				</Anchors>
			</Frame>
			<Frame parentKey="TextFrame">
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="mouseWarn" inherits="QuestHUDFont" text="MOUSE ON" hidden="true" />
						<FontString parentKey="coords" inherits="QuestHUDFont" hidden="true" />
						<FontString parentKey="time" inherits="QuestHUDFont" hidden="true" />
						<FontString parentArray="cardinalPoints" inherits="QuestHUDFont" text="N" />
						<FontString parentArray="cardinalPoints" inherits="QuestHUDFont" text="NE" />
						<FontString parentArray="cardinalPoints" inherits="QuestHUDFont" text="E" />
						<FontString parentArray="cardinalPoints" inherits="QuestHUDFont" text="SE" />
						<FontString parentArray="cardinalPoints" inherits="QuestHUDFont" text="S" />
						<FontString parentArray="cardinalPoints" inherits="QuestHUDFont" text="SW" />
						<FontString parentArray="cardinalPoints" inherits="QuestHUDFont" text="W" />
						<FontString parentArray="cardinalPoints" inherits="QuestHUDFont" text="NW" />
					</Layer>
				</Layers>
			</Frame>
			<Frame parentKey="onScreenButtons" hidden="true">
				<Size x="1" y="1" />
				<Frames>
					<Button parentKey="mouseButton" inherits="QuestHUDOnScreenButtonTemplate" id="1">
						<Anchors>
							<Anchor point="CENTER" x="-34"/>
						</Anchors>
						<NormalTexture file="Interface\AddOns\QuestHUD\media\Mouse-Normal"/>
						<PushedTexture file="Interface\AddOns\QuestHUD\media\Mouse-Pushed"/>
					</Button>
					<Button parentKey="backgroundButton" inherits="QuestHUDOnScreenButtonTemplate" id="2">
						<Anchors>
							<Anchor point="CENTER" x="-12"/>
						</Anchors>
						<NormalTexture file="Interface\WorldMap\WorldMap-Icon" />
						<PushedTexture file="Interface\WorldMap\WorldMap-Icon" desaturated="true" />
					</Button>
					<Button parentKey="optionsButton" inherits="QuestHUDOnScreenButtonTemplate" id="3">
						<Anchors>
							<Anchor point="CENTER" x="12"/>
						</Anchors>
						<NormalTexture file="Interface\AddOns\QuestHUD\media\options" />
						<PushedTexture file="Interface\AddOns\QuestHUD\media\options" desaturated="true" />
					</Button>
					<Button parentKey="closeButton" inherits="QuestHUDOnScreenButtonTemplate" id="4">
						<Anchors>
							<Anchor point="CENTER" x="34"/>
						</Anchors>
						<NormalTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Up"/>
						<PushedTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Down"/>
					</Button>
				</Frames>
			</Frame>
			<Frame parentKey="HideElements" hidden="true" />
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad" />
			<OnEvent method="OnEvent" />
			<OnShow method="OnShow" />
			<OnHide method="OnHide"/>
		</Scripts>
	</Frame>

</Ui>
